# ── mcp read-data backbone — configuration (all secrets via env only) ──
# Copy to .env and fill in. Nothing here touches funds/signing; these are read credentials.

# HTTP
PORT=8787
# Comma-separated allowed CORS origins (the app origins). No wildcard in prod.
CORS_ORIGINS=http://localhost:5173,https://app.spiralstake.xyz
LOG_LEVEL=info

# On-chain reads (viem)
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
# Optional — Robinhood Chain (4663), only needed if spUSDG markets are configured.
ROBINHOOD_RPC_URL=

# Upstream APIs
COINGECKO_API_KEY=
ROYCO_API_KEY=
# Dashboard backend (read-only upstream for /apy). Do NOT modify that backend.
DASHBOARD_API_URL=https://api.spiralstake.xyz

# Warmer — set to "false" to disable background warming (reads then serve cold/last-good only).
WARMER_ENABLED=true
# Chain the service composes for.
CHAIN_ID=1
