{
  "name": "@spiralstake/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Spiral Stake composition authority + read API — the read-data backbone (Step 1a).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx --enable-source-maps src/index.ts",
    "typecheck": "tsc --noEmit",
